# Application URL
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth Secret (generate with: openssl rand -base64 32)
BETTER_AUTH_SECRET=replace_with_a_secure_random_string_at_least_32_chars

# Database (PostgreSQL - compatible with Neon, Supabase, AWS RDS, local Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saas_starterkit

# Midtrans Payment Gateway (Sandbox)
# Obtain these from your Midtrans Dashboard -> Settings -> Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false

# Cron Secret (required for /api/billing/cron triggers)
# The endpoint fails closed with HTTP 500 when this is unset, so set it in every
# environment that has a scheduler. Generate with: openssl rand -base64 32
# When set, it must be at least 32 characters or the build fails (pnpm check:deploy-env).
CRON_SECRET=generate_with_openssl_rand_base64_32
